# 本地联调模板 —— 复制成 .env 后按需填写；.env 已被 .gitignore 排除，绝不要提交。
#
# 线上站点不需要这里的任何值：模型密钥存为 Qoder Sites 的应用 Secret（DASHSCOPE_API_KEY），
# 由平台注入 Function 运行环境，浏览器永远拿不到。
#
# 只有想在本机直接跑 Function 时才需要填，启动时显式加载：
#   deno run --env-file=.env --allow-net --allow-env functions/index.ts
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen4-max
# 可选，默认公共兼容接口；使用专属工作空间地址时再覆盖。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1